# --- Обязательные ---
# Токен чат-бота MAX. Никогда не попадает в репозиторий и не уходит клиенту.
# Получить: business.max.ru → Чат-боты → нужный бот → ⋮ → Настройки → Токен.
# Вписывается только в локальный .env.
MAX_BOT_TOKEN=

# --- Мини-приложение ---
# Режим кнопки в облегчённом боте (bot/max_bot.py):
#   mini_app — мини-приложение внутри MAX (нужен URL в business.max.ru)
#   link     — обычная ссылка; code.py сам поднимает туннель, если URL не задан
MINIAPP_MODE=mini_app

# Постоянный HTTPS-адрес мини-приложения.
# Для облегчённого бота (MINIAPP_URL) и бэкенда (MINI_APP_URL) можно задать оба —
# code.py подставляет найденный адрес в обе переменные автоматически.
# MINIAPP_URL=https://maxevgst19.github.io/TimeBalanceBot/miniapp/
MINI_APP_URL=

# --- База и планирование ---
# Файл базы SQLite.
TIMEBALANCE_DB=timebalance.db
# Начало учебного дня: до него свободные окна не считаются.
DAY_START=07:00

# --- Сервер ---
HOST=127.0.0.1
PORT=8000

# --- Сессии ---
SESSION_TTL_SECONDS=604800
# Срок жизни данных запуска MAX; старше — 401 init_data_expired.
INIT_DATA_MAX_AGE_SECONDS=86400
# Секрет для подписи сессий. Если не задан — выводится из MAX_BOT_TOKEN.
# JWT_SECRET=

# --- Бот и уведомления ---
ENABLE_BOT=true
ENABLE_NOTIFIER=true
NOTIFIER_INTERVAL_SECONDS=60

# Необязательно: username бота (берётся автоматически из GET /me)
# MAX_BOT_USERNAME=

# Необязательно: адрес Bot API (по умолчанию https://platform-api2.max.ru)
# MAX_API_URL=
