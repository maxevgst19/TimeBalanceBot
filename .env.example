# Токен чат-бота из business.max.ru → Чат-боты → ⋮ → Настройки → Токен
MAX_BOT_TOKEN=

# Режим кнопки:
#   mini_app — мини-приложение внутри MAX (нужен URL в business.max.ru) — по умолчанию
#   link     — обычная ссылка, открывается в браузере (для быстрого теста)
MINIAPP_MODE=mini_app

# Постоянный HTTPS-адрес мини-приложения.
# Подставь его же в business.max.ru → Настройки → ссылка на мини-приложение.
# MINIAPP_URL=https://maxevgst19.github.io/TimeBalanceBot/miniapp/

# Необязательно: username бота (берётся автоматически из GET /me)
# MAX_BOT_USERNAME=

# Необязательно: адрес Bot API (по умолчанию https://platform-api2.max.ru)
# MAX_API_URL=
