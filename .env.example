# --- Обязательные ---
# Токен чат-бота MAX. Никогда не попадает в репозиторий и не уходит клиенту.
# Получить: MAX → управление ботом → токен. Вписывается только в локальный .env.
MAX_BOT_TOKEN=

# --- Часто нужные ---
# Ссылка на мини-приложение, её бот отдаёт по кнопке «Открыть».
MINI_APP_URL=https://example.com/app
# Строка подключения PostgreSQL (Render: Internal Database URL).
DATABASE_URL=postgresql://timebalance:timebalance_dev@127.0.0.1:5433/timebalance
# Начало учебного дня: до него свободные окна не считаются.
DAY_START=07:00

# --- Сервер ---
HOST=127.0.0.1
PORT=8000

# --- Сессии ---
SESSION_TTL_SECONDS=604800
# Срок жизни данных запуска MAX; старше — 401 init_data_expired.
INIT_DATA_MAX_AGE_SECONDS=86400
# Секрет для подписи сессий. Если не задан — выводится из MAX_BOT_TOKEN.
# JWT_SECRET=

# --- Бот и уведомления ---
ENABLE_BOT=true
ENABLE_NOTIFIER=true
NOTIFIER_INTERVAL_SECONDS=60
